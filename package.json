{
  "name": "noesis-flow",
  "version": "1.0.7",
  "description": "A private, Markdown-native task hub for capture and planning.",
  "main": "main.js",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2ak3n/noesis-flow.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "productivity",
    "markdown"
  ],
  "author": "k2ak3n",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.27.0",
    "eslint": "^10.0.1",
    "moment": "^2.30.1",
    "obsidian": "1.13.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
